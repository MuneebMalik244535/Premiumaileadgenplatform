# General Environment
ENVIRONMENT=production

# Database Configuration (SQLite for local dev, PostgreSQL for production docker)
# Local SQLite fallback: sqlite:///./leads.db
# PostgreSQL: postgresql://leadgen_user:leadgen_pass_secure_99@localhost:5432/leadgen_db
DATABASE_URL=postgresql://leadgen_user:leadgen_pass_secure_99@postgres:5432/leadgen_db

# Redis & Task Queue
REDIS_URL=redis://redis:6379/0
USE_CELERY=true

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_string
ADMIN_USERNAME=""
ADMIN_PASSWORD=change_this_secure_password_in_prod

# CORS Security
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Scraper Proxy Pool & Performance Tuning
PROXY_LIST=http://proxy1.example.com:8080,http://proxy2.example.com:8080
SCRAPER_WORKERS=20
AI_WORKERS=16
